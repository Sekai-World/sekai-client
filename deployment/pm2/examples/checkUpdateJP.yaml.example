# One-process-per-file PM2 YAML template for checkUpdate-jp.
#
# Generate a real deployment file with envsubst, e.g.:
#   export INTERNAL_RPC_TOKEN='...'  AES_KEY='...'  REMOTE_GIT_BASE_URL='https://github.com/Sekai-World'
#   export STRAPI_BASE_URL='...'  STRAPI_TOKEN='...'
#   envsubst < checkUpdateJP.yaml.example > /root/pm2/checkUpdateJP.yaml
#
# Sensitive values are ${VARIABLE_NAME} placeholders. Production does not set
# ALLOW_INSECURE_INTERNAL_RPC / ENABLE_UNSAFE_PJSK_RPC.
apps:
  - name: checkUpdate-jp
    script: uv run python check_update.py
    cwd: /root/sekai-client
    env:
      SEKAI_REGION: jp
      AES_IV: 6d737833495630693958453575595a31
      AES_KEY: ${AES_KEY}
      CHECK_UPDATE_SIMPLE_MODE: "false"
      CHECK_UPDATE_VERSIONS_URL: ""
      ENABLE_SEKAI_UPDATE_MASTER: "true"
      ENABLE_SEKAI_UPDATE_USER_INFO: "true"
      ENABLE_SEKAI_UPDATE_I18N: "true"
      GIT_FOLDER_SEKAI_I18N: sekai-i18n
      GIT_FOLDER_SEKAI_MASTER_DB_DIFF: sekai-master-db-diff
      JSONRPC_PORT: "39390"
      LOGLEVEL: DEBUG
      REMOTE_GIT_BASE_URL: https://github.com/Sekai-World
      STRAPI_BASE_URL: ${STRAPI_BASE_URL}
      STRAPI_TOKEN: ${STRAPI_TOKEN}
      INTERNAL_RPC_TOKEN: ${INTERNAL_RPC_TOKEN}
