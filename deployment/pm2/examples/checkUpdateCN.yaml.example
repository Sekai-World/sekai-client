# One-process-per-file PM2 YAML template for checkUpdate-cn (standalone, simple mode).
#
# Generate a real deployment file with envsubst, e.g.:
#   export AES_KEY='...'  REMOTE_GIT_BASE_URL='https://github.com/Sekai-World'
#   envsubst < checkUpdateCN.yaml.example > /root/pm2/checkUpdateCN.yaml
#
# Sensitive values are ${VARIABLE_NAME} placeholders. Production does not set
# ALLOW_INSECURE_INTERNAL_RPC / ENABLE_UNSAFE_PJSK_RPC.
apps:
  - name: checkUpdate-cn
    script: uv run python check_update.py
    cwd: /root/sekai-client
    env:
      SEKAI_REGION: cn
      AES_IV: 6d737833495630693958453575595a31
      AES_KEY: ${AES_KEY}
      APP_VER: 6.0.0
      CHECK_UPDATE_SIMPLE_MODE: "true"
      CHECK_UPDATE_VERSIONS_URL: https://raw.githubusercontent.com/Team-Haruki/haruki-sekai-sc-master/refs/heads/main/versions/current_version.json
      ENABLE_SEKAI_UPDATE_MASTER: "true"
      ENABLE_SEKAI_UPDATE_USER_INFO: "false"
      GIT_FOLDER_SEKAI_MASTER_DB_DIFF: sekai-master-db-cn-diff
      LOGLEVEL: DEBUG
      REMOTE_GIT_BASE_URL: https://github.com/Sekai-World
