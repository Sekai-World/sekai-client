# One-process-per-file PM2 YAML template for sharedApiClient-en.
#
# Generate a real deployment file with envsubst, e.g.:
#   export INTERNAL_RPC_TOKEN='...'  AES_KEY='...'
#   envsubst < sharedApiClientEN.yaml.example > /root/pm2/sharedApiClientEN.yaml
#
# Sensitive values are ${VARIABLE_NAME} placeholders. Production does not set
# ALLOW_INSECURE_INTERNAL_RPC / ENABLE_UNSAFE_PJSK_RPC.
apps:
  - name: sharedApiClient-en
    script: uv run gunicorn --config gunicorn_conf.py --worker-class gevent --workers 1 --timeout 0 --bind 127.0.0.1:39392 shared_client:app
    cwd: /root/sekai-client
    env:
      SEKAI_REGION: en
      AES_IV: 7E856C907987F8AEC6AFC0C54738FC7E
      AES_KEY: ${AES_KEY}
      ALL_PROXY: ""
      # EN app/data/asset versions and app hash are sourced at runtime from
      # Team-Haruki's authoritative current_version.json.
      # Set EN_CURRENT_VERSION_URL in the process environment to override it.
      HTTPS_PROXY: ""
      LOGLEVEL: DEBUG
      INTERNAL_RPC_TOKEN: ${INTERNAL_RPC_TOKEN}
