# One-process-per-file PM2 YAML template for eventTracker-en.
#
# Generate a real deployment file with envsubst, e.g.:
#   export INTERNAL_RPC_TOKEN='...'  STRAPI_BASE_URL='...'  SEKAI_API_KEY='...'
#   envsubst < eventTrackerEN.yaml.example > /root/pm2/eventTrackerEN.yaml
#
# Sensitive values are ${VARIABLE_NAME} placeholders. Production does not set
# ALLOW_INSECURE_INTERNAL_RPC / ENABLE_UNSAFE_PJSK_RPC.
apps:
  - name: eventTracker-en
    script: uv run python event_tracker.py
    cwd: /root/sekai-client
    env:
      SEKAI_REGION: en
      JSONRPC_PORT: "39392"
      LOGLEVEL: DEBUG
      SEKAI_API_KEY: ${SEKAI_API_KEY}
      STRAPI_BASE_URL: ${STRAPI_BASE_URL}
      INTERNAL_RPC_TOKEN: ${INTERNAL_RPC_TOKEN}
      EVENT_TRACKER_OUTBOX_PATH: /root/sekai-client/.runtime/event-tracker-en.sqlite3
